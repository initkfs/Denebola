 * Authors: initkfs
 */

size_t fontIndex(uint c)
{
    if (c >= 0x0430 && c <= 0x044F)
        c -= 32;
    if (c == 0x0451)
        c = 0x0401; // ё -> Ё

    return uniIndex(c);
}

