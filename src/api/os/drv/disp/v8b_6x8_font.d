enum FontSize = 8;

import Buffer = api.os.drv.disp.v8b_128x64_buff;

bool drawAsciiChar(char c, ubyte[] frameBuffer, int startX = 0, int pageY = 0, size_t maxWidth = 128)
{
    ubyte asciiCode = cast(ubyte) c;

    if (asciiCode < 0x20)
        return false;

    //starts from space
    int fontIndex = asciiCode - 0x20;

    if (fontIndex >= asciiFont.length)
        return false;

    for (int col = 0; col < FontSize; col++)
    {
        int currentX = startX + col;

        if (currentX >= maxWidth)
            break;
        if (currentX < 0)
            continue;

        int fbIndex = (pageY * maxWidth) + currentX;

        if (fbIndex >= frameBuffer.length)
            return false;

        //Buffer.frameBuffer.ptr[fbIndex] |= asciiFont[fontIndex * FontSize + col];
        Buffer.frameBuffer.ptr[fbIndex] = asciiFont[fontIndex * FontSize + col];
    }

    return true;
}

bool drawString(const(char)[] text, ubyte[] frameBuffer, int startX = 0, int pageY = 0, size_t maxWidth = 128, size_t maxPages = 8)
{
    if (text.length == 0)
    {
        return false;
    }

    int currentX = startX;

    foreach (char c; text)
    {
        if (currentX >= maxWidth)
        {
            if (pageY == (maxPages - 1))
            {
                return false;
            }
            pageY++;
            currentX = 0;
        }

        if (!drawAsciiChar(c, frameBuffer, currentX, pageY))
        {
            return false;
        }
        currentX += FontSize;
    }

    return true;
}
